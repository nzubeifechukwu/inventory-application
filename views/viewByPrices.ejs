<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>View By | <%= pageTitle %></title>
  </head>
  <body>
    <nav><%- include('partials/navbar.ejs')%></nav>
    <nav><%- include('partials/viewByPricesNavbar.ejs') %></nav>
    <header></header>
    <main>
      <section>
        <% if (books.length) {%> <% books.forEach((book) => { %>
        <article>
          <h2><%= book.title %></h2>
          <p><%= book.author %></p>
          <a href="/<%= book.id %>/edit">Edit</a>
          <form action="/<%= book.id %>/delete" method="post">
            <button
              type="submit"
              onclick="return confirm('Are you sure you want to delete this book?')"
            >
              Delete
            </button>
          </form>
        </article>
        <%}); %>
      </section>
      <form action="/delete" method="post">
        <button
          type="submit"
          onclick="return confirm('Are you sure you want to delete all books?')"
        >
          Delete All
        </button>
      </form>
      <% } else { %>
      <p>No books found. Click <strong>Add Book</strong> to add a new book.</p>
      <% } %>
    </main>
    <footer></footer>
  </body>
</html>
