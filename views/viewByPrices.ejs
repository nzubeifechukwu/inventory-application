<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>View By | <%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <nav>
      <section><%- include('partials/navbar.ejs')%></section>
      <section><%- include('partials/viewByPricesNavbar.ejs') %></section>
    </nav>
    <header><h1>Book Inventory</h1></header>
    <main>
      <section>
        <% if (books.length) {%> <% books.forEach((book) => { %>
        <article>
          <h2><%= book.title %></h2>
          <h3><%= book.author %></h3>
          <p><span>$<%= book.selling_price %></span></p>
          <p><span><%= book.quantity_sold %></span> copies sold</p>
          <p><span><%= book.quantity_in_stock %></span> copies in stock</p>
          <div class="edit-delete">
            <a href="/<%= book.id %>/edit">Edit</a>
            <form action="/<%= book.id %>/delete" method="post">
              <button
                type="submit"
                onclick="return confirm('Are you sure you want to delete this book?')"
              >
                Delete
              </button>
            </form>
          </div>
        </article>
        <%}); %>
      </section>
      <form action="/delete" method="post" class="delete-all">
        <button
          type="submit"
          onclick="return confirm('Are you sure you want to delete all books?')"
        >
          Delete All
        </button>
      </form>
      <% } else { %>
      <p>No books found. Click <strong>Add Book</strong> to add a new book.</p>
      <% } %>
    </main>
    <footer><small>&copy; Nzube Ifechukwu</small></footer>
  </body>
</html>
